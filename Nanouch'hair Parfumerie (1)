.fab { position: fixed; right: calc(16px + env(safe-area-inset-right,0px)); bottom: calc(16px + env(safe-area-inset-bottom,0px)); z-index: 6; width: 58px; height: 58px; border-radius: 50%; background: var(--wa); display: grid; place-items: center; box-shadow: rgba(74, 42, 48, 0.28) 0px 6px 18px; }

.fab svg { width: 30px; height: 30px; }

footer { border-top: 1px solid var(--line); background: var(--shelf); }

footer .wrap { padding-block: 28px; display: grid; gap: 10px; justify-items: center; text-align: center; font-size: 12px; color: var(--muted); }

dialog { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; background: transparent; max-width: min(92vw, 720px); max-height: 92vh; }

dialog::backdrop { background: rgba(40, 18, 24, 0.82); }

dialog img { max-height: 84vh; width: auto; max-width: 100%; border-radius: 10px; display: block; margin: 0px auto; }

dialog .bar2 { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: 10px; }

dialog .close { background: var(--card); color: var(--wine); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 999px; padding: 8px 16px; font: inherit; cursor: pointer; }

@media (prefers-reduced-motion: no-preference) {
  .card { transition: transform 0.2s; }
  .card:hover { transform: translateY(-2px); }
}

.music { position: fixed; left: calc(16px + env(safe-area-inset-left,0px)); bottom: calc(20px + env(safe-area-inset-bottom,0px)); z-index: 6; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--gold); background: var(--card); color: var(--wine); border-radius: 999px; padding: 10px 16px; font-style: inherit; font-variant: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: rgba(74, 42, 48, 0.18) 0px 6px 18px; }

.music[aria-pressed="true"] { background: var(--wine); color: rgb(255, 255, 255); border-color: var(--wine); }

.music .bars { display: inline-flex; gap: 2px; align-items: flex-end; height: 12px; }

.music .bars i { width: 3px; height: 4px; background: currentcolor; border-radius: 1px; }

@media (prefers-reduced-motion: no-preference) {
  .music[aria-pressed="true"] .bars i { animation: 1s ease-in-out 0s infinite normal none running eq; }
  .music .bars i:nth-child(2) { animation-delay: 0.2s; }
  .music .bars i:nth-child(3) { animation-delay: 0.4s; }
}

@keyframes eq { 
  0%, 100% { height: 4px; }
  50% { height: 12px; }
}
